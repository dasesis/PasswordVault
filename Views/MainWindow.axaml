<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PassowrdVault.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="350"
        Width="450" Height="350"
        WindowStartupLocation="CenterScreen"
        x:Class="PassowrdVault.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PassowrdVault">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto" Margin="30">
        <!-- Nadpis -->
        <TextBlock Grid.Row="0" 
                   Text="🔐 Password Vault" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Formulář pro zamknutý stav -->
        <StackPanel Grid.Row="1" Spacing="15" VerticalAlignment="Center" IsVisible="{Binding !IsUnlocked}">
            <TextBlock Text="Zadej master heslo:" Foreground="Gray"/>
            
            <TextBox Text="{Binding MasterPassword}" 
                     PasswordChar="*" 
                     PlaceholderText="Master heslo..." />

            <Button Content="Odemknout / Vytvořit trezor" 
                    Command="{Binding UnlockCommand}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center" />
        </StackPanel>

        <!-- Zobrazení po odemčení -->
        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsUnlocked}">
            <TextBlock Text="🔓 Trezor je odemčen!" 
                       FontSize="18" 
                       Foreground="LightGreen" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Chybové / stavové hlášky -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusMessage}" 
                   Foreground="Orange" 
                   HorizontalAlignment="Center" 
                   Margin="0,15,0,0"/>
    </Grid>

</Window>